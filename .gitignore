# PocketBase
# Runtime data is NOT committed. pb_data holds live applicant uploads and the
# database; only the storage/.gitkeep placeholder is tracked. See
# docs/system-improvements.md S1 (RA 10173 sensitive personal information).
pb_data/*.db-shm
pb_data/*.db-wal
pb_data/*.db-journal
pb_data/.lock
pb_data/types.d.ts
backups/

pb_data/*.db
pb_data/storage/**
!pb_data/storage/.gitkeep

# Node / Frontend build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
release/dist/
release/.staging/
release/bin/
!release/bin/.gitkeep

# Env files (commit a .env.example instead)
.env
.env.*
.env.local
.env.*.local
!.env.example

# General
.DS_Store
Thumbs.db
*.log
pb_data/auxiliary.db
pb_data/data.db
cline_mcp_settings.json
package-lock.json
package.json
