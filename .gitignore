# PocketBase
# Runtime data is NOT committed. pb_data holds live applicant uploads and the
# database; only the storage/.gitkeep placeholder is tracked. See
# docs/system-improvements.md S1 (RA 10173 sensitive personal information).
pb_data/*.db-shm
pb_data/*.db-wal
pb_data/*.db-journal
pb_data/.lock
pb_data/types.d.ts
backups/

pb_data/*.db
pb_data/storage/**
!pb_data/storage/.gitkeep

# Node / Frontend build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
release/dist/
release/.staging/
release/bin/
!release/bin/.gitkeep

# Env files (commit a .env.example instead)
.env
.env.*
.env.local
.env.*.local
!.env.example

# Incident worksheet holding real data-subject names and record IDs. The repository is
# publicly readable until docs/system-improvements.md S1 is closed, so identifying
# details never go in a tracked file. Notification drafts live here, not in docs/.
incident-private/

# General
.DS_Store
Thumbs.db
*.log
# Agent scratch space. Inspecting the live database writes temporary copies here, and a bare
# `git add .` would stage them — the exact runtime-data failure mode S1 describes.
.qwen/
pb_data/auxiliary.db
pb_data/data.db
cline_mcp_settings.json
package-lock.json
package.json
